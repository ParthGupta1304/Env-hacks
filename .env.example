# Empty = local rules, no account or network required.
# Set to the SAM ApiBaseUrl output only after deployment.
VITE_API_BASE_URL=
VITE_APP_ENV=development
# Public identifiers only; never put AWS access keys in a VITE_ variable.
VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
